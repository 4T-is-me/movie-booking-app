<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected state (Black fill, Gold border) -->
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/black" />
            <stroke android:width="1.5dp" android:color="@color/gold_selected" />
        </shape>
    </item>
    <!-- Default state (Light semi-transparent white fill) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/auto_color_1AFFFFFF" />
        </shape>
    </item>
</selector>
