    <!-- Glowing Moon -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="-30">
        
        <!-- Glowing Light -->
        <path android:pathData="M 54,22 A 32,32 0 0,0 54,86 A 24,32 0 0,1 54,22 Z"
              android:strokeWidth="12" android:strokeColor="#22FFD966" android:strokeLineCap="round"/>
