            L 40,63 A 2.5,2.5 0 0,0 40,58
            L 40,57 A 2,2 0 0,1 42,55 Z"
            android:fillColor="#E8C87A" />

        <!-- Ticket Inner Border -->
        <path android:pathData="M 43,58 L 77,58 L 77,72 L 43,72 Z"
              android:strokeWidth="1" android:strokeColor="#C59A45" />

        <!-- Center Star Accent -->
        <path android:pathData="M 60,61.5 L 61,64 L 64,64 L 61.5,65.5 L 62.5,68.5 L 60,66.5 L 57.5,68.5 L 58.5,65.5 L 56,64 L 59,64 Z"
