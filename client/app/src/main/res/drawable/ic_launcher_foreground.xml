              android:strokeWidth="4" android:strokeColor="#55FFD966" android:strokeLineCap="round"/>

        <!-- Moon Body -->
        <path android:pathData="M 54,22 A 32,32 0 0,0 54,86 A 24,32 0 0,1 54,22 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:startX="22" android:startY="22" android:endX="86" android:endY="86" android:type="linear">
                    <item android:offset="0.0" android:color="#FFD966" />
                    <item android:offset="1.0" android:color="#B8860B" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- Golden Ticket -->
    <group android:pivotX="60" android:pivotY="65" android:rotation="-15">
        
        <!-- Ticket Base with perforations and rounded corners -->
        <path android:pathData="
            M 42,55
            L 78,55
            A 2,2 0 0,1 80,57
            L 80,58 A 2.5,2.5 0 0,0 80,63
            L 80,67 A 2.5,2.5 0 0,0 80,72
