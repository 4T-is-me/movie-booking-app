<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected state (Gold border, dark gold background) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <stroke android:width="1.5dp" android:color="@color/gold_selected" />
            <solid android:color="#26FFC107" />
        </shape>
    </item>
    <!-- Default state (Light white/grey border, semi-transparent background) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
            <solid android:color="#12FFFFFF" />
        </shape>
    </item>
</selector>
