<?xml version="1.0" encoding="utf-8"?>
<!-- [Legacy: XML Views] - CONSTRAINT: Dùng để căn chỉnh tiêu đề, điểm số và nút bấm đúng vị trí -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <!-- [Legacy: XML Views] - TEXTVIEW: Hiển thị tên phim (Dữ liệu từ Intent) -->
    <TextView
        android:id="@+id/tvDetailTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tên phim sẽ hiện ở đây"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- [Legacy: XML Views] - TEXTVIEW: Hiển thị điểm số -->
    <TextView
        android:id="@+id/tvDetailRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Rating: 0.0"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/tvDetailTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- MaterialButton: Linh kiện nút bấm từ thư viện Material Design -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBookTicket"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="ĐẶT VÉ NGAY"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>