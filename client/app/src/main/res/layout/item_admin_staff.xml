<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="?attr/selectableItemBackground"
    android:paddingVertical="12dp"
    android:weightSum="4"
    android:gravity="center_vertical">

    <!-- Full Name -->
    <TextView
        android:id="@+id/tvStaffFullName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.8"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:ellipsize="end"
        android:maxLines="1"/>

    <!-- Position -->
    <TextView
        android:id="@+id/tvStaffPosition"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.0"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:ellipsize="end"
        android:maxLines="1"/>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/btnDetailStaff"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:src="@android:drawable/ic_menu_info_details"
            android:contentDescription="@string/menu_staff_detail"
            app:tint="@color/yellow"
            android:clickable="true"
            android:focusable="true"/>

        <ImageView
            android:id="@+id/btnEditStaff"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:src="@android:drawable/ic_menu_edit"
            android:contentDescription="@string/menu_edit_staff"
            app:tint="@color/yellow"
            android:clickable="true"
            android:focusable="true"/>

        <ImageView
            android:id="@+id/btnDeleteStaff"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@android:drawable/ic_menu_delete"
            android:contentDescription="Delete Staff"
            app:tint="@color/deduct"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>
</LinearLayout>
