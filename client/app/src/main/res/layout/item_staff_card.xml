<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardShiftItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_dark"
    android:padding="16dp"
    android:foreground="?android:attr/selectableItemBackground">

    <!--  Avatar Text -->
    <FrameLayout
        android:id="@+id/avatarFrame"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_tab_active"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvAvatarText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/bg_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="NT" />
    </FrameLayout>

    <!--  Replace/Edit button -->
    <ImageButton
        android:id="@+id/btnEditShift"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_circle_glass"
        android:padding="7dp"
        android:src="@android:drawable/ic_menu_edit"
        app:tint="@color/color_gold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 3. Tên Nhân Viên -->
    <TextView
        android:id="@+id/tvStaffName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btnEditShift"
        app:layout_constraintStart_toEndOf="@id/avatarFrame"
        app:layout_constraintTop_toTopOf="@id/avatarFrame"
        tools:text="Nguyễn Văn Thanh" />

    <!-- Rating & Position -->
    <LinearLayout
        android:id="@+id/layoutSubInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toStartOf="@id/btnEditShift"
        app:layout_constraintStart_toStartOf="@id/tvStaffName"
        app:layout_constraintTop_toBottomOf="@id/tvStaffName">

        <TextView
            android:id="@+id/tvPosition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="Thu ngân tại quầy" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:text="@string/auto_str_str_auto_10"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvStaffRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_gold"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="⭐ 4.8" />
    </LinearLayout>

    <!-- Subtle divider to separate information -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/auto_color_1AFFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tvStaffName"
        app:layout_constraintTop_toBottomOf="@id/layoutSubInfo" />

    <LinearLayout
        android:id="@+id/layoutShiftDetails"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toStartOf="@id/tvStatusBadge"
        app:layout_constraintStart_toStartOf="@id/tvStaffName"
        app:layout_constraintTop_toBottomOf="@id/divider">

        <TextView
            android:id="@+id/tvWorkDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/auto_color_B0B0B0"
            android:textSize="12sp"
            tools:text="Date: 15/07/2026" />

        <TextView
            android:id="@+id/tvShift"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/auto_color_FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Afternoon (12:00 - 17:00)" />
    </LinearLayout>

    <!--  Status Badge-->
    <TextView
        android:id="@+id/tvStatusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/status_active_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="@color/auto_color_34C759"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/layoutShiftDetails"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/layoutShiftDetails"
        tools:text="Assigned" />

</androidx.constraintlayout.widget.ConstraintLayout>