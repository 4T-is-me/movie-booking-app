<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_dark"
    android:padding="16dp">

    <!-- Avatar Text -->
    <FrameLayout
        android:id="@+id/avatarFrame"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_tab_active">

        <TextView
            android:id="@+id/tvAvatarText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="NT"
            android:textColor="@color/bg_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Status Badge (Active / Assigned / Absent) -->
    <TextView
        android:id="@+id/tvStatusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="@drawable/status_active_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="Assigned"
        android:textColor="#34C759"
        android:textSize="11sp"
        android:textStyle="bold" />

   <!-- Name, Position & Rating Information -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/avatarFrame"
        android:layout_toStartOf="@id/tvStatusBadge"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:layout_centerVertical="true"
        android:orientation="vertical">

        <!-- name + Rating -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStaffName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                tools:text="Nguyễn Văn Thanh" />

    
            <TextView
                android:id="@+id/tvStaffRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_gold"
                android:textStyle="bold"
                android:textSize="13sp"
                android:gravity="center_vertical"
                tools:text="⭐ 4.8" />
        </LinearLayout>

        <!-- Position -->
        <TextView
            android:id="@+id/tvPosition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            tools:text="Thu ngân tại quầy" />

        <!-- Work Date -->
        <TextView
            android:id="@+id/tvWorkDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="#B0B0B0"
            tools:text="Schedule: 15/07/2026" />

        <!-- Shift -->
        <TextView
            android:id="@+id/tvShift"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="#B0B0B0"
            tools:text="Shift: Afternoon (12:00 - 17:00)" />

        <!-- Attendance -->
        <TextView
            android:id="@+id/tvAttendance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="11sp"
            android:textColor="#8A8A8A"
            tools:text="Attendance: 90% (450 pts)" />

    </LinearLayout>

</RelativeLayout>