<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="24dp"
    android:background="@color/background_black">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvTitlePromo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/promo_title"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvSeeAllPromo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/see_all"
            android:textColor="@color/yellow"
            android:textSize="14sp"
            app:layout_constraintTop_toTopOf="@id/tvTitlePromo"
            app:layout_constraintBottom_toBottomOf="@id/tvTitlePromo"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vpPromo"
            android:layout_width="match_parent"
            android:layout_height="200dp" />

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerPromo"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:visibility="gone"
            app:shimmer_auto_start="true"
            app:shimmer_base_alpha="0.1"
            app:shimmer_highlight_alpha="0.4">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="16dp"
                android:background="@color/skeleton_gray" />
        </com.facebook.shimmer.ShimmerFrameLayout>
    </FrameLayout>

</LinearLayout>
