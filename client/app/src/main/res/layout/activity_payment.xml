                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_id_card" app:tint="#F5C542"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:text="International Card" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp" />
                    <RadioButton android:id="@+id/rbInternational" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="false" android:buttonTint="#F5C542"/>
                </LinearLayout>

