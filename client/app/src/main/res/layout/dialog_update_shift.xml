<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    android:background="@drawable/bg_tab_container"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_str_update_shift"
        android:textColor="@color/auto_color_FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/auto_str_update_shift_details_and_assig"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Staff Selection -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/auto_str_staff"
        android:textColor="@color/auto_color_FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerStaff"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_circle_glass"
        android:paddingHorizontal="12dp" />

    <!-- Work Date (Read-only / Display) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/auto_str_work_date"
        android:textColor="@color/auto_color_FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWorkDate"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_circle_glass"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:textColor="@color/auto_color_FFFFFF"
        android:textSize="14sp" />

    <!-- Shift Selection -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/auto_str_shift"
        android:textColor="@color/auto_color_FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerShift"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_circle_glass"
        android:paddingHorizontal="12dp"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/auto_color_FFFFFF"/>

    <!-- Status Selection -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/auto_str_status"
        android:textColor="@color/auto_color_FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerStatus"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_circle_glass"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/auto_color_FFFFFF"
        android:paddingHorizontal="12dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/auto_str_cancel"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_active_gold"
            android:text="@string/auto_str_save"
            android:textColor="@color/bg_primary"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>