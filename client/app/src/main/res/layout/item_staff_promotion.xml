<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/auto_color_0D1120"
    app:cardCornerRadius="8dp"
    app:strokeColor="@color/admin_gold_transparent"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgPromoIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_dialog_info"
            android:scaleType="fitCenter"
            android:background="@color/auto_color_151A30"
            android:padding="4dp"
            app:tint="@color/gold_selected" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStaffPromoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="SUMMER20" />

            <TextView
                android:id="@+id/tvStaffPromoDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/admin_text_secondary"
                android:textSize="11sp"
                tools:text="Giảm 20% tổng hoá đơn" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStaffPromoCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/auto_color_33FFC107"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textColor="@color/gold_selected"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="SUMMER20" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
