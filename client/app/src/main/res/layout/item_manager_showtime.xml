<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="12dp">

    <FrameLayout
        android:id="@+id/indicatorContainer"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_circle_glass"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/viewDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_dot_live" />
    </FrameLayout>

    <View
        android:id="@+id/lineVertical"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="@color/color_green_status"
        app:layout_constraintTop_toBottomOf="@id/indicatorContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/indicatorContainer"
        app:layout_constraintEnd_toEndOf="@id/indicatorContainer"/>

    <LinearLayout
        android:id="@+id/infoContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/indicatorContainer"
        app:layout_constraintEnd_toStartOf="@id/statusContainer"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvMovieName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_str_oppenheimer"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRoomAndTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_str_hall_a_13_45_16_45"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvSeatsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_str_98_120_seats"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"/>

        </RelativeLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/statusContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:background="@drawable/bg_status_live_pill"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_str_live"
            android:textColor="@color/seat_selected"
            android:textSize="11sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbOccupancy"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:progress="82"
        android:max="100"
        android:progressDrawable="@drawable/custom_progressbar_yellow"
        app:layout_constraintTop_toBottomOf="@id/infoContainer"
        app:layout_constraintStart_toStartOf="@id/infoContainer"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvOccupancyPercentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:text="@string/auto_str_82"
        android:textColor="@color/seat_selected"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/pbOccupancy"
        android:layout_marginBottom="6dp" />

</androidx.constraintlayout.widget.ConstraintLayout>