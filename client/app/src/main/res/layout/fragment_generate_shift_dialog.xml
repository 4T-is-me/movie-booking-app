<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tab_container"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_margin="30dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_str_auto_generate_staff_shifts"
        android:textColor="@color/auto_color_FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/auto_str_select_the_date_range_to_autom"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Start Date Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/auto_str_start_date"
        android:textColor="@color/auto_color_FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStartDate"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_circle_glass"
        android:gravity="center_vertical"
        android:hint="YYYY-MM-DD"
        android:paddingHorizontal="12dp"
        android:textColor="@color/auto_color_FFFFFF"
        android:textColorHint="@color/text_secondary"
        android:textSize="14sp" />

    <!-- End Date Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/auto_str_end_date"
        android:textColor="@color/auto_color_FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvEndDate"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_circle_glass"
        android:gravity="center_vertical"
        android:hint="YYYY-MM-DD"
        android:paddingHorizontal="12dp"
        android:textColor="@color/auto_color_FFFFFF"
        android:textColorHint="@color/text_secondary"
        android:textSize="14sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/auto_str_cancel_2"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/btnConfirmGenerate"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_active_gold"
            android:text="@string/auto_str_generate"
            android:textColor="@color/bg_primary"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>