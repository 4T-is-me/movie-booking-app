<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardMyTicketItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="14dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="#1E1E1E"
    app:strokeWidth="1dp"
    app:strokeColor="#33FFFFFF"
    app:cardElevation="3dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Movie Poster -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivPoster"
            android:layout_width="90dp"
            android:layout_height="130dp"
            android:scaleType="centerCrop"
            android:background="#2C2C2C"
            app:shapeAppearanceOverlay="@style/RoundedImageView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- QR Code (Right Side) -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivQrCode"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:scaleType="fitCenter"
            android:background="@color/white"
            android:padding="4dp"
            app:shapeAppearanceOverlay="@style/RoundedImageView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:visibility="visible" />

        <!-- Movie Title -->
        <TextView
            android:id="@+id/tvMovieTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/ivPoster"
            app:layout_constraintEnd_toStartOf="@id/ivQrCode"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Avengers: Infinity War" />

        <!-- Time & Date -->
        <LinearLayout
            android:id="@+id/layoutShowtime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintStart_toEndOf="@id/ivPoster"
            app:layout_constraintEnd_toStartOf="@id/ivQrCode"
            app:layout_constraintTop_toBottomOf="@id/tvMovieTitle">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_calendar_month_24"
                app:tint="#F5C542" />

            <TextView
                android:id="@+id/tvShowtime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="#BBFFFFFF"
                android:textSize="12sp"
                tools:text="16/10/2026 • 14:15" />
        </LinearLayout>

        <!-- Location & Room -->
        <LinearLayout
            android:id="@+id/layoutCinema"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintStart_toEndOf="@id/ivPoster"
            app:layout_constraintEnd_toStartOf="@id/ivQrCode"
            app:layout_constraintTop_toBottomOf="@id/layoutShowtime">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_location"
                app:tint="#F5C542" />

            <TextView
                android:id="@+id/tvCinemaRoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="#BBFFFFFF"
                android:textSize="12sp"
                tools:text="CGV Vincom Center • Room 5" />
        </LinearLayout>

        <!-- Seats -->
        <TextView
            android:id="@+id/tvSeats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:textColor="#88FFFFFF"
            android:textSize="11sp"
            app:layout_constraintStart_toEndOf="@id/ivPoster"
            app:layout_constraintEnd_toStartOf="@id/ivQrCode"
            app:layout_constraintTop_toBottomOf="@id/layoutCinema"
            tools:text="Seats: H7, H8" />

        <!-- Booking ID -->
        <TextView
            android:id="@+id/tvBookingCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:textColor="#88FFFFFF"
            android:textSize="11sp"
            app:layout_constraintStart_toEndOf="@id/ivPoster"
            app:layout_constraintEnd_toStartOf="@id/ivQrCode"
            app:layout_constraintTop_toBottomOf="@id/tvSeats"
            tools:text="Booking ID: BK20261016001" />

        <!-- Total Paid -->
        <TextView
            android:id="@+id/tvTotalPaid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:textColor="#F5C542"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/ivPoster"
            app:layout_constraintEnd_toStartOf="@id/ivQrCode"
            app:layout_constraintTop_toBottomOf="@id/tvBookingCode"
            tools:text="Total Paid: 180,000 ₫" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
