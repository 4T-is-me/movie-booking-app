<?xml version="1.0" encoding="utf-8"?>
<!-- 🧱 [VIEW/LAYOUT]: CÁI KHUÔN BÁNH CHO MỘT DÒNG TODO -->
<!-- - ĐÂY LÀ GÌ: Bản vẽ thiết kế cho một mục duy nhất trong danh sách. -->
<!-- - MỤC ĐÍCH: Quy định hình dáng, màu sắc và vị trí của Checkbox và Chữ. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Ô tích chọn: Nằm sát bên trái -->
        <CheckBox
            android:id="@+id/cbCompleted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Tên việc: Nằm bên phải cái CheckBox, lấp đầy phần còn lại (0dp) -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvTodoTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="noi dung cong viec"
            android:textColor="@color/black"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@id/cbCompleted"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cbCompleted"
            app:layout_constraintTop_toTopOf="@id/cbCompleted" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
