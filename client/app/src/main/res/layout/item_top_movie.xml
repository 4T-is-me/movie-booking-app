<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="10dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/txtRank"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_circle_glass"
            android:backgroundTint="@color/auto_color_EAB308"
            android:text="@string/auto_str_1_1"
            android:textColor="@color/auto_color_0B0F19"
            android:textStyle="bold"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"/>

        <TextView
            android:id="@+id/txtMovieTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/txtRank"
            android:layout_marginStart="12dp"
            android:layout_centerVertical="true"
            android:text="@string/auto_str_dune_part_two"
            android:textColor="@color/auto_color_FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTicketCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="@string/auto_str_1_240_tkts"
            android:textColor="@color/auto_color_94A3B8"
            android:textSize="13sp" />
    </RelativeLayout>

    <ProgressBar
        android:id="@+id/progressMovie"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:progress="100"
        android:max="100"
        android:progressDrawable="@android:drawable/progress_horizontal"
        android:progressTint="@color/yellow" />
</LinearLayout>