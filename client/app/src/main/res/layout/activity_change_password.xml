<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#000000">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:tint="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Change Password"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Keep your account secure by using a strong password."
            android:textColor="#808080"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Current Password Label -->
        <TextView
            android:id="@+id/tvCurrentPasswordLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current password"
            android:textColor="#9E9E9E"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Current Password Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCurrentPassword"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:elevation="2dp"
            app:boxBackgroundColor="#1A1A1A"
            app:boxStrokeColor="@color/change_password_input_stroke"
            app:boxStrokeErrorColor="#E53935"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxBackgroundMode="outline"
            app:hintEnabled="false"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/change_password_end_icon_tint"
            app:startIconDrawable="@drawable/ic_lock"
            app:startIconTint="#F5C542"
            app:errorEnabled="true"
            app:errorTextColor="#E53935"
            app:layout_constraintTop_toBottomOf="@id/tvCurrentPasswordLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtCurrentPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter your current password"
                android:textColorHint="#9E9E9E"
                android:textColor="#FFFFFF"
                android:inputType="textPassword"
                android:textSize="13sp"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- New Password Label -->
        <TextView
            android:id="@+id/tvNewPasswordLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New password"
            android:textColor="#9E9E9E"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tilCurrentPassword"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- New Password Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNewPassword"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:elevation="2dp"
            app:boxBackgroundColor="#1A1A1A"
            app:boxStrokeColor="@color/change_password_input_stroke"
            app:boxStrokeErrorColor="#E53935"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxBackgroundMode="outline"
            app:hintEnabled="false"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/change_password_end_icon_tint"
            app:startIconDrawable="@drawable/ic_lock"
            app:startIconTint="#F5C542"
            app:errorEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/tvNewPasswordLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtNewPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter your new password"
                android:textColorHint="#9E9E9E"
                android:textColor="#FFFFFF"
                android:inputType="textPassword"
                android:textSize="13sp"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Confirm New Password Label -->
        <TextView
            android:id="@+id/tvConfirmPasswordLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirm new password"
            android:textColor="#9E9E9E"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tilNewPassword"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Confirm New Password Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilConfirmPassword"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:elevation="2dp"
            app:boxBackgroundColor="#1A1A1A"
            app:boxStrokeColor="@color/change_password_input_stroke"
            app:boxStrokeErrorColor="#E53935"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxBackgroundMode="outline"
            app:hintEnabled="false"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/change_password_end_icon_tint"
            app:startIconDrawable="@drawable/ic_lock"
            app:startIconTint="#F5C542"
            app:errorEnabled="true"
            app:errorTextColor="#E53935"
            app:layout_constraintTop_toBottomOf="@id/tvConfirmPasswordLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter your password"
                android:textColorHint="#9E9E9E"
                android:textColor="#FFFFFF"
                android:inputType="textPassword"
                android:textSize="13sp"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password Requirements Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRequirements"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="#33FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/tilConfirmPassword"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password requirements:"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Req 1: 6 chars -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:id="@+id/ivReqLength"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_circle_gray" />

                    <TextView
                        android:id="@+id/tvReqLength"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="At least 6 characters"
                        android:textColor="#808080"
                        android:textSize="13sp"
                        android:layout_marginStart="10dp" />
                </LinearLayout>

                <!-- Req 2: Uppercase -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:id="@+id/ivReqUppercase"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_circle_gray" />

                    <TextView
                        android:id="@+id/tvReqUppercase"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="At least 1 uppercase letter"
                        android:textColor="#808080"
                        android:textSize="13sp"
                        android:layout_marginStart="10dp" />
                </LinearLayout>

                <!-- Req 3: Lowercase -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:id="@+id/ivReqLowercase"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_circle_gray" />

                    <TextView
                        android:id="@+id/tvReqLowercase"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="At least 1 lowercase letter"
                        android:textColor="#808080"
                        android:textSize="13sp"
                        android:layout_marginStart="10dp" />
                </LinearLayout>

                <!-- Req 4: Number -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:id="@+id/ivReqNumber"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_circle_gray" />

                    <TextView
                        android:id="@+id/tvReqNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="At least 1 number"
                        android:textColor="#808080"
                        android:textSize="13sp"
                        android:layout_marginStart="10dp" />
                </LinearLayout>

                <!-- Req 5: Special character -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivReqSpecial"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_circle_gray" />

                    <TextView
                        android:id="@+id/tvReqSpecial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="At least 1 special character"
                        android:textColor="#808080"
                        android:textSize="13sp"
                        android:layout_marginStart="10dp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Button Container -->
        <FrameLayout
            android:id="@+id/layoutBtnUpdate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/cardRequirements"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdatePassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Update password"
                android:textColor="#000000"
                app:backgroundTint="#F5C542"
                android:textStyle="bold"
                android:textSize="16sp"
                app:cornerRadius="28dp"
                android:enabled="false" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressLoading"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:visibility="gone"
                app:indicatorColor="#000000"
                app:trackThickness="2.5dp" />
        </FrameLayout>

        <!-- Bottom Warning -->
        <LinearLayout
            android:id="@+id/layoutWarning"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/layoutBtnUpdate"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check_circle_gold"
                app:tint="#F5C542" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="For your security, avoid using easy-to-guess password like your birthday or name"
                android:textColor="#808080"
                android:textSize="12sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
