<?xml version="1.0" encoding="utf-8"?>
<!-- 🏪 [VIEW/LAYOUT]: CÁI KỆ TRƯNG BÀY DANH SÁCH -->
<!-- - ĐÂY LÀ GÌ: Bản vẽ thiết kế cho toàn bộ màn hình Todo. -->
<!-- - MỤC ĐÍCH: Chứa cái kệ RecyclerView khổng lồ để "đựng" các viên gạch Todo. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Cái kệ thông minh: Chỉ vẽ những gì người dùng đang thấy để tiết kiệm pin -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTodos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

</androidx.constraintlayout.widget.ConstraintLayout>
