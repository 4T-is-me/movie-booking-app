<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardBackgroundColor="@color/auto_color_1A1B23"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_str_employee_details"
            android:textColor="@color/auto_color_FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <!-- Scrollable Details -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:scrollbars="vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Row: Username -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_str_username"
                        android:textColor="@color/auto_color_8E8E93"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tvDetailUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/auto_color_FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Row: Full Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_str_full_name"
                        android:textColor="@color/auto_color_8E8E93"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tvDetailFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/auto_color_FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Row: Position -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_str_position"
                        android:textColor="@color/auto_color_8E8E93"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tvDetailPosition"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/auto_color_FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Row: Email -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_str_email"
                        android:textColor="@color/auto_color_8E8E93"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tvDetailEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/auto_color_FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Row: Phone -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_str_phone_number"
                        android:textColor="@color/auto_color_8E8E93"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tvDetailPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/auto_color_FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Row: DOB & Gender -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:paddingVertical="6dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_str_date_of_birth"
                            android:textColor="@color/auto_color_8E8E93"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/tvDetailDob"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/auto_color_FFFFFF"
                            android:textSize="14sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_str_gender"
                            android:textColor="@color/auto_color_8E8E93"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/tvDetailGender"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/auto_color_FFFFFF"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row: Identity Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_str_identity_card"
                        android:textColor="@color/auto_color_8E8E93"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tvDetailIdentityCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/auto_color_FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Row: Address -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_str_address_1"
                        android:textColor="@color/auto_color_8E8E93"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tvDetailAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/auto_color_FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>


                <!-- Row: Start Date -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_str_start_date"
                        android:textColor="@color/auto_color_8E8E93"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tvDetailStartDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/auto_color_FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Row: KPI & Ticket Sold & Rating -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:paddingVertical="6dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_str_kpi"
                            android:textColor="@color/auto_color_8E8E93"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/tvDetailKpi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/auto_color_FFFFFF"
                            android:textSize="14sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_str_tickets_sold"
                            android:textColor="@color/auto_color_8E8E93"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/tvDetailTicketSold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/auto_color_FFFFFF"
                            android:textSize="14sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_str_rating"
                            android:textColor="@color/auto_color_8E8E93"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/tvDetailRating"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/auto_color_FFFFFF"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Close Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseDetail"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/auto_str_close"
            android:textColor="@color/auto_color_000000"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/yellow"
            app:cornerRadius="24dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
