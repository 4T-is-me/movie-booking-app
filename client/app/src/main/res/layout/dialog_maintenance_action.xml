<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    app:cardBackgroundColor="@color/auto_color_1A1829"
    app:cardCornerRadius="24dp"
    app:cardElevation="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Top Header Icon Badge -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_notification_badge"
            android:backgroundTint="@color/auto_color_33F59E0B"
            android:padding="14dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_notifications"
                app:tint="@color/auto_color_F59E0B" />
        </FrameLayout>

        <!-- Dialog Title -->
        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/auto_str_s_c_ph_ng_chi_u_c_n_x_c_nh_n"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Info Detail Box Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/auto_color_252238"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvDialogMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_slate_200"
                android:textSize="14sp"
                tools:text="Suất chiếu Avengers: Infinity War tại phòng Phòng 1 gặp sự cố..." />
        </LinearLayout>

        <!-- Accept Button (Primary Gold) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccept"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="@string/auto_str_ng_d_i_v"
            android:textColor="@color/cinema_dark_input"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/gold_selected"
            app:cornerRadius="14dp" />

        <!-- Decline Button (Secondary Red Soft Outline) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDecline"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="@string/auto_str_t_ch_i_ho_n_100_i_m"
            android:textColor="@color/auto_color_F87171"
            android:textSize="14sp"
            app:backgroundTint="@color/auto_color_2DEF4444"
            app:cornerRadius="14dp"
            app:strokeColor="@color/auto_color_7FEF4444"
            app:strokeWidth="1dp" />

        <!-- Later Text Button -->
        <TextView
            android:id="@+id/tvDismiss"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:padding="8dp"
            android:text="@string/auto_str_sau"
            android:textColor="@color/hint_gray"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
