<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    app:cardBackgroundColor="#1A1829"
    app:cardCornerRadius="24dp"
    app:cardElevation="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Top Header Icon Badge -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_notification_badge"
            android:backgroundTint="#33F59E0B"
            android:padding="14dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_notifications"
                app:tint="#F59E0B" />
        </FrameLayout>

        <!-- Dialog Title -->
        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Sự cố phòng chiếu - Cần xác nhận"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Info Detail Box Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#252238"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvDialogMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textColor="#E2E8F0"
                android:textSize="14sp"
                tools:text="Suất chiếu Avengers: Infinity War tại phòng Phòng 1 gặp sự cố..." />
        </LinearLayout>

        <!-- Accept Button (Primary Gold) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccept"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="✓  ĐỒNG Ý DỜI VÉ"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#F5C518"
            app:cornerRadius="14dp" />

        <!-- Decline Button (Secondary Red Soft Outline) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDecline"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="✕  Từ chối (Hoàn 100% điểm)"
            android:textColor="#F87171"
            android:textSize="14sp"
            app:backgroundTint="#2DEF4444"
            app:cornerRadius="14dp"
            app:strokeColor="#7FEF4444"
            app:strokeWidth="1dp" />

        <!-- Later Text Button -->
        <TextView
            android:id="@+id/tvDismiss"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:padding="8dp"
            android:text="Để sau"
            android:textColor="#9CA3AF"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
