<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="16dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cvComingSoonPoster"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        app:cardCornerRadius="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivComingSoonPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/auto_color_333333" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvComingSoonTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/auto_str_avatar_2_the_way_of_water"
        android:textColor="@color/auto_color_FFC107"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/cvComingSoonPoster"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvComingSoonGenres"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/auto_str_adventure_sci_fi"
        android:textColor="@color/auto_color_AAAAAA"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        app:layout_constraintTop_toBottomOf="@id/tvComingSoonTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvComingSoonDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/auto_str_20_12_2022"
        android:textColor="@color/auto_color_AAAAAA"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvComingSoonGenres"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
