<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/auto_color_111827">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_str_edit_pricing"
        android:textColor="@color/auto_color_FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_str_standard_price"
        android:textColor="@color/auto_color_94A3B8"
        android:textSize="12sp" />
    <EditText
        android:id="@+id/etStdPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:textColor="@color/auto_color_FFFFFF"
        android:backgroundTint="@color/auto_color_60A5FA"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_str_vip_price"
        android:textColor="@color/auto_color_94A3B8"
        android:textSize="12sp" />
    <EditText
        android:id="@+id/etVipPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:textColor="@color/auto_color_FFFFFF"
        android:backgroundTint="@color/auto_color_FACC15"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_str_couple_price"
        android:textColor="@color/auto_color_94A3B8"
        android:textSize="12sp" />
    <EditText
        android:id="@+id/etCouplePrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:textColor="@color/auto_color_FFFFFF"
        android:backgroundTint="@color/auto_color_A78BFA"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/auto_str_cancel_3"
            android:backgroundTint="@color/auto_color_334155"
            android:textColor="@color/auto_color_FFFFFF" />
        <View android:layout_width="16dp" android:layout_height="match_parent" />
        <Button
            android:id="@+id/btnSavePricing"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/auto_str_save_temporary"
            android:backgroundTint="@color/auto_color_10B981"
            android:textColor="@color/black" />
    </LinearLayout>
</LinearLayout>
