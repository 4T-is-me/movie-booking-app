<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_black"
    tools:context=".view.activity.ManagerActivity">

    <!-- Main Content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Header -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/auto_color_D9111827"
            android:paddingHorizontal="16dp"
            android:paddingTop="32dp"
            android:paddingBottom="12dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivMenu"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_glass"
                android:padding="8dp"
                android:src="@drawable/ic_menu"
                app:tint="@color/auto_color_FFFFFF"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@id/ivMenu"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_str_dashboard"
                    android:textColor="@color/auto_color_FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_str_lumina_landmark_81"
                    android:textColor="@color/auto_color_94A3B8"
                    android:textSize="11sp"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/ivNotification"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_glass"
                android:padding="8dp"
                android:src="@drawable/ic_notifications"
                app:tint="@color/auto_color_CBD5E1"
                android:layout_marginEnd="12dp"
                app:layout_constraintEnd_toStartOf="@id/ivAvatar"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/ivAvatar"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_badge_gold"
                android:text="@string/auto_str_tb"
                android:gravity="center"
                android:textColor="@color/auto_color_FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constraintTop_toBottomOf="@id/headerLayout"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Greeting Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_gradient_purple"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tvGreeting" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_str_good_evening" android:textColor="@color/auto_color_94A3B8" android:textSize="12sp"/>
                        <TextView android:id="@+id/tvManagerName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_str_tr_n_th_b_nh" android:textColor="@color/auto_color_FFFFFF" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
                        <TextView android:id="@+id/tvDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_str_wednesday_20_06_2024" android:textColor="@color/auto_color_94A3B8" android:textSize="11sp" android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_str_branch_online" android:textColor="@color/auto_color_10B981" android:background="@drawable/bg_status_operating" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:textSize="11sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvAllRoom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_str_mgr_001_5_rooms" android:textColor="@color/auto_color_94A3B8" android:textSize="10sp" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- KPI Grid -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:rowCount="2"
                    android:layout_marginBottom="16dp">

                    <!-- Card 1 -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_card_dark" android:orientation="vertical" android:padding="12dp">
                        <TextView android:id="@+id/tvRevenue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_str_45_2m" android:textColor="@color/auto_color_FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_str_revenue" android:textColor="@color/auto_color_94A3B8" android:textSize="10sp"/>
                    </LinearLayout>
                    <!-- Card 2 -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_card_dark" android:orientation="vertical" android:padding="12dp">
                        <TextView android:id="@+id/tvTicketsSold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_str_387" android:textColor="@color/auto_color_FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_str_tickets" android:textColor="@color/auto_color_94A3B8" android:textSize="10sp"/>
                    </LinearLayout>
                    <!-- Card 3 -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_card_dark" android:orientation="vertical" android:padding="12dp">
                        <TextView android:id="@+id/tvOccupancyRate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_str_78" android:textColor="@color/auto_color_FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_str_occupancy" android:textColor="@color/auto_color_94A3B8" android:textSize="10sp"/>
                    </LinearLayout>
                    <!-- Card 4 -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_card_dark" android:orientation="vertical" android:padding="12dp">
                        <TextView android:id="@+id/tvFoodRevenue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_str_12_3m" android:textColor="@color/auto_color_FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_str_f_amp_b_rev" android:textColor="@color/auto_color_94A3B8" android:textSize="10sp"/>
                    </LinearLayout>
                    <!-- Card 5 -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_card_dark" android:orientation="vertical" android:padding="12dp">
                        <TextView android:id="@+id/tvRunningMovies" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_str_6" android:textColor="@color/auto_color_FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_str_movies" android:textColor="@color/auto_color_94A3B8" android:textSize="10sp"/>
                    </LinearLayout>
                    <!-- Card 6 -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_card_dark" android:orientation="vertical" android:padding="12dp">
                        <TextView android:id="@+id/tvActiveScreens" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_str_4_5" android:textColor="@color/auto_color_FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_str_screens" android:textColor="@color/auto_color_94A3B8" android:textSize="10sp"/>
                    </LinearLayout>
                </GridLayout>

                <!-- Quick Actions -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="2"
                    android:layout_marginBottom="16dp">
                    <Button android:id="@+id/layoutSchedule" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="@string/auto_str_schedule" android:backgroundTint="#1AA855F7" android:textColor="@color/auto_color_FFFFFF" app:icon="@drawable/ic_calendar_month_24" app:iconTint="#A855F7" android:textAlignment="textStart"/>
                    <Button android:id="@+id/layoutRooms" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="@string/auto_str_rooms" android:backgroundTint="#1A60A5FA" android:textColor="@color/auto_color_FFFFFF" app:iconTint="#60A5FA"  app:icon="@drawable/ic_room" android:textAlignment="textStart"/>
                    <Button android:id="@+id/layoutStaff" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="@string/auto_str_staff" android:backgroundTint="#1A10B981" android:textColor="@color/auto_color_FFFFFF" app:iconTint="#10B981" app:icon="@drawable/ic_staff" android:textAlignment="textStart"/>
                    <Button android:id="@+id/layoutReports" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="@string/auto_str_reports" android:backgroundTint="#1AD4AF37" android:textColor="@color/auto_color_FFFFFF" app:iconTint="#D4AF37" app:icon="@drawable/ic_report" android:textAlignment="textStart"/>
                </GridLayout>

                <!-- Today's Showtimes Placeholder -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_dark"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_str_today_s_showtimes"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvViewAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerInParent="true"
                            android:text="@string/auto_str_view_all"
                            android:textColor="@color/yellow"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                    </RelativeLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvTodayShowtimes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        android:orientation="vertical"
                        tools:listitem="@layout/item_manager_showtime" />

                    <TextView
                        android:id="@+id/tvNoShowtimes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="24dp"
                        android:gravity="center"
                        android:text="@string/auto_str_no_showtimes_scheduled_for_tod"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_str_weekly_revenue"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_str_revenue_from_the_last_7_days"
                        android:textColor="@color/auto_color_8A8A8F"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"/>

                    <!-- Biểu đồ đường -->
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/lineChartWeekly"
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:layout_marginTop="16dp" />

                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/admin_bg"
        app:itemTextColor="#CBD5E1"
        app:itemIconTint="#CBD5E1"
        app:headerLayout="@layout/nav_manager_header"
        app:menu="@menu/manager_drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
