<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090B13"
    tools:context=".view.activity.ManagerActivity">

    <!-- Main Content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Header -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#D9111827"
            android:paddingHorizontal="16dp"
            android:paddingTop="32dp"
            android:paddingBottom="12dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivMenu"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_glass"
                android:padding="8dp"
                android:src="@drawable/ic_menu"
                app:tint="#FFFFFF"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@id/ivMenu"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dashboard"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LUMINA Landmark 81"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/ivNotification"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_glass"
                android:padding="8dp"
                android:src="@drawable/ic_notifications"
                app:tint="#CBD5E1"
                android:layout_marginEnd="12dp"
                app:layout_constraintEnd_toStartOf="@id/ivAvatar"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/ivAvatar"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_badge_gold"
                android:text="TB"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/headerLayout"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Greeting Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_gradient_purple"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Good evening 🌙" android:textColor="#94A3B8" android:textSize="12sp"/>
                        <TextView android:id="@+id/tvManagerName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trần Thị Bình" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
                        <TextView android:id="@+id/tvDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wednesday, 20/06/2024" android:textColor="#94A3B8" android:textSize="11sp" android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● Branch Online" android:textColor="#10B981" android:background="@drawable/bg_status_operating" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:textSize="11sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MGR-001 · 5 rooms" android:textColor="#94A3B8" android:textSize="10sp" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- KPI Grid -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:rowCount="2"
                    android:layout_marginBottom="16dp">
                    
                    <!-- Card 1 -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_card_dark" android:orientation="vertical" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="45.2M" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Revenue" android:textColor="#94A3B8" android:textSize="10sp"/>
                    </LinearLayout>
                    <!-- Card 2 -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_card_dark" android:orientation="vertical" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="387" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tickets" android:textColor="#94A3B8" android:textSize="10sp"/>
                    </LinearLayout>
                    <!-- Card 3 -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_card_dark" android:orientation="vertical" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="78%" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Occupancy" android:textColor="#94A3B8" android:textSize="10sp"/>
                    </LinearLayout>
                    <!-- Card 4 -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_card_dark" android:orientation="vertical" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12.3M" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="F&amp;B Rev" android:textColor="#94A3B8" android:textSize="10sp"/>
                    </LinearLayout>
                    <!-- Card 5 -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_card_dark" android:orientation="vertical" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Movies" android:textColor="#94A3B8" android:textSize="10sp"/>
                    </LinearLayout>
                    <!-- Card 6 -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_card_dark" android:orientation="vertical" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4/5" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Screens" android:textColor="#94A3B8" android:textSize="10sp"/>
                    </LinearLayout>
                </GridLayout>

                <!-- Quick Actions -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="2"
                    android:layout_marginBottom="16dp">
                    <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="Schedule" android:backgroundTint="#1AA855F7" android:textColor="#FFFFFF" app:icon="@drawable/ic_calendar_month_24" app:iconTint="#A855F7" android:textAlignment="textStart"/>
                    <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="Rooms" android:backgroundTint="#1A60A5FA" android:textColor="#FFFFFF" app:iconTint="#60A5FA" android:textAlignment="textStart"/>
                    <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="Staff" android:backgroundTint="#1A10B981" android:textColor="#FFFFFF" app:iconTint="#10B981" android:textAlignment="textStart"/>
                    <Button android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="Reports" android:backgroundTint="#1AD4AF37" android:textColor="#FFFFFF" app:iconTint="#D4AF37" android:textAlignment="textStart"/>
                </GridLayout>

                <!-- Today's Showtimes Placeholder -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_dark"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today's Showtimes" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="13:45 - Oppenheimer - Hall A" android:textColor="#CBD5E1" android:textSize="13sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15:00 - Inception - Hall B" android:textColor="#CBD5E1" android:textSize="13sp" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#0D1120"
        app:itemTextColor="#CBD5E1"
        app:itemIconTint="#CBD5E1"
        app:headerLayout="@layout/nav_manager_header"
        app:menu="@menu/manager_drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
