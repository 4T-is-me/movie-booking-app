<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/auto_color_111827"
    app:cardMaxElevation="0dp">

    <!-- Stroke/Border cho CardView (sử dụng background của LinearLayout con nếu cần, hoặc CardView stroke nếu dùng MaterialCardView) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_manager_room_card"
        android:padding="16dp">

        <!-- Top Section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Icon -->
            <FrameLayout
                android:id="@+id/flIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_manager_room_icon"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true">
                
                <!-- Sử dụng ký tự hoặc icon drawable -->
                <ImageView
                    android:id="@+id/ivMovie"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_movie"
                    app:tint="@color/auto_color_10B981" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_toEndOf="@id/flIcon"
                android:layout_toStartOf="@id/tvOperating"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/tvRoomName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_str_hall_a_premium"
                    android:textColor="@color/auto_color_FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTotalSeats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/auto_str_120_seats_standard"
                    android:textColor="@color/auto_color_94A3B8"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvOperating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:background="@drawable/bg_label_operating"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="@string/auto_str_operating_2"
                android:textColor="@color/auto_color_10B981"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Unavailable Message -->
        <TextView
            android:id="@+id/tvRoomUnavailable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="64dp"
            android:text="@string/auto_str_room_unavailable_tap_to_manage"
            android:textColor="@color/auto_color_F59E0B"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@color/auto_color_33FFFFFF" />

        <!-- Stats & Manage -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Std -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvStdCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_str_90"
                    android:textColor="@color/auto_color_60A5FA"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/auto_str_std"
                    android:textColor="@color/auto_color_94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- VIP -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvVipCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_str_20_1"
                    android:textColor="@color/auto_color_FACC15"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/auto_str_vip_4"
                    android:textColor="@color/auto_color_94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Couple -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvCoupleCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_str_10_2"
                    android:textColor="@color/auto_color_A78BFA"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/auto_str_couple_2"
                    android:textColor="@color/auto_color_94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Divider Vertical -->
            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginHorizontal="8dp"
                android:background="@color/auto_color_33FFFFFF" />

            <!-- Manage Button -->
            <LinearLayout
                android:id="@+id/btnManage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="0dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_str_manage"
                    android:textColor="@color/auto_color_A78BFA"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@android:drawable/ic_media_play"
                    app:tint="@color/auto_color_A78BFA" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
