<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auto_color_000000">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/auto_color_000000"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/auto_color_FFFFFF" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_str_edit_profile"
            android:textColor="@color/auto_color_FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Profile Header with Avatar & Camera Overlay -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:background="@color/avatar_bg"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/CircleImageView" />

                <!-- Camera overlay icon -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnChangeAvatar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/auto_color_F5C542"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp"
                    app:layout_constraintBottom_toBottomOf="@id/ivAvatar"
                    app:layout_constraintEnd_toEndOf="@id/ivAvatar">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_camera" />

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Helper Text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:text="@string/auto_str_tap_the_camera_icon_to_change"
                android:textColor="@color/auto_color_5C5C5C"
                android:textSize="12sp" />

            <!-- Personal Information Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/auto_str_personal_infomation"
                android:textColor="@color/auto_color_FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Fields -->
            <com.example.movie_booking_app.view.widget.ProfileFieldView
                android:id="@+id/fieldFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:fieldEditable="true"
                app:fieldHint="Full Name"
                app:fieldIcon="@drawable/ic_profile"
                app:fieldLabel="Full name" />

            <com.example.movie_booking_app.view.widget.ProfileFieldView
                android:id="@+id/fieldDateOfBirth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:fieldEditable="false"
                app:fieldHint="DD/MM/YYYY"
                app:fieldIcon="@drawable/ic_calendar_month_24"
                app:fieldLabel="Date of birth" />

            <com.example.movie_booking_app.view.widget.ProfileFieldView
                android:id="@+id/fieldGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:fieldEditable="false"
                app:fieldHint="Select Gender"
                app:fieldIcon="@drawable/ic_gender"
                app:fieldLabel="Gender" />

            <com.example.movie_booking_app.view.widget.ProfileFieldView
                android:id="@+id/fieldPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:fieldEditable="true"
                app:fieldHint="Phone Number"
                app:fieldIcon="@drawable/ic_phone"
                app:fieldLabel="Phone" />

            <com.example.movie_booking_app.view.widget.ProfileFieldView
                android:id="@+id/fieldIdentityCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:fieldEditable="true"
                app:fieldHint="Identity Card"
                app:fieldIcon="@drawable/ic_id_card"
                app:fieldLabel="Identity card" />

            <com.example.movie_booking_app.view.widget.ProfileFieldView
                android:id="@+id/fieldEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:fieldEditable="false"
                app:fieldHint="Email Address"
                app:fieldIcon="@drawable/ic_email"
                app:fieldLabel="Email" />

            <!-- Address Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/auto_str_address"
                android:textColor="@color/auto_color_FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.example.movie_booking_app.view.widget.ProfileFieldView
                android:id="@+id/fieldAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:fieldEditable="true"
                app:fieldHint="Enter your address"
                app:fieldIcon="@drawable/ic_location"
                app:fieldLabel="Address" />

            <!-- Preferences Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/auto_str_preferences"
                android:textColor="@color/auto_color_FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.example.movie_booking_app.view.widget.ProfileFieldView
                android:id="@+id/fieldFavoriteCinema"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:fieldEditable="false"
                app:fieldHint="Select Favorite Cinema"
                app:fieldIcon="@drawable/ic_cinema"
                app:fieldLabel="Favorite Cinema" />

            <com.example.movie_booking_app.view.widget.ProfileFieldView
                android:id="@+id/fieldFavoriteGenre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                app:fieldEditable="false"
                app:fieldHint="Select Favorite Genres"
                app:fieldIcon="@drawable/ic_genre"
                app:fieldLabel="Favorite Genre" />

            <!-- Save Changes Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveChanges"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="24dp"
                android:text="@string/auto_str_save_changes"
                android:textColor="@color/auto_color_000000"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/auto_color_F5C542"
                app:cornerRadius="28dp"
                app:rippleColor="@color/auto_color_22000000" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation (Fixed) -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/nav_border"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/btnNavHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/imgNavHome"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                app:tint="@color/nav_inactive" />
            <TextView
                android:id="@+id/tvNavHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_home"
                android:textColor="@color/nav_inactive"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnNavTicket"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/imgNavTicket"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_ticket"
                app:tint="@color/nav_inactive" />
            <TextView
                android:id="@+id/tvNavTicket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_ticket"
                android:textColor="@color/nav_inactive"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnNavMovie"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/imgNavMovie"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_movie"
                app:tint="@color/nav_inactive" />
            <TextView
                android:id="@+id/tvNavMovie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_movie"
                android:textColor="@color/nav_inactive"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnNavProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/imgNavProfile"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_profile"
                app:tint="@color/auto_color_F5C542" />
            <TextView
                android:id="@+id/tvNavProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_profile"
                android:textColor="@color/auto_color_F5C542"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Full Screen Loading Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/auto_color_80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/auto_color_F5C542"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
