<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_custom"> <ImageView
    android:id="@+id/ivErrorIcon"
    android:layout_width="64dp"
    android:layout_height="64dp"
    android:src="@android:drawable/ic_dialog_alert"
    android:layout_marginBottom="16dp"
    android:contentDescription="Error Icon" />

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_str_update_failed"
        android:textColor="@color/auto_color_FF4D4D"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auto_str_this_staff_has_already_been_as"
        android:textColor="@color/auto_color_FFFFFF"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnDialogOk"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/auto_str_ok"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textColor="@color/auto_color_000000"
        android:backgroundTint="@color/auto_color_FFCC00" /> </LinearLayout>