<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auto_color_0A0F1E"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Top Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_manager_room_icon"
                android:padding="10dp"
                android:src="@drawable/ic_back"
                android:layout_centerVertical="true"
                app:tint="@color/auto_color_FFFFFF" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_toEndOf="@id/ivBack"
                android:layout_toStartOf="@id/tvTopStatus"
                android:layout_marginStart="16dp"
                android:layout_centerVertical="true">

                <TextView
                    android:id="@+id/tvRoomName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_str_hall_c_imax"
                    android:textColor="@color/auto_color_FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRoomSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/auto_str_150_seats_imax"
                    android:textColor="@color/auto_color_94A3B8"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTopStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_label_operating"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/auto_str_operating"
                android:textColor="@color/auto_color_10B981"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>
        
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/auto_color_33FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ROOM STATUS CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/auto_color_111827"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_str_room_status"
                        android:textColor="@color/auto_color_94A3B8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">
                        
                        <TextView
                            android:id="@+id/btnStatusOperating"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_status_selected"
                            android:text="@string/auto_str_operating_1"
                            android:textColor="@color/auto_color_10B981"
                            android:gravity="center"
                            android:paddingVertical="12dp"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                            
                        <View android:layout_width="12dp" android:layout_height="match_parent" />
                        
                        <TextView
                            android:id="@+id/btnStatusMaintenance"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_status_unselected"
                            android:text="@string/auto_str_maintenance"
                            android:textColor="@color/auto_color_94A3B8"
                            android:gravity="center"
                            android:paddingVertical="12dp"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                            
                        <View android:layout_width="12dp" android:layout_height="match_parent" />
                        
                        <TextView
                            android:id="@+id/btnStatusClosed"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_status_unselected"
                            android:text="@string/auto_str_closed"
                            android:textColor="@color/auto_color_94A3B8"
                            android:gravity="center"
                            android:paddingVertical="12dp"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SEAT CONFIGURATION CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/auto_color_111827"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_str_seat_configuration"
                        android:textColor="@color/auto_color_94A3B8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <!-- Standard -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/bg_seat_config_item"
                            android:padding="12dp"
                            android:gravity="center">
                            
                            <TextView
                                android:id="@+id/tvConfigStdCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/auto_str_120"
                                android:textColor="@color/auto_color_60A5FA"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/auto_str_standard"
                                android:textColor="@color/auto_color_94A3B8"
                                android:textSize="12sp" />
                        </LinearLayout>
                        
                        <View android:layout_width="12dp" android:layout_height="match_parent" />

                        <!-- VIP -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/bg_seat_config_item"
                            android:padding="12dp"
                            android:gravity="center">
                            
                            <TextView
                                android:id="@+id/tvConfigVipCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/auto_str_20"
                                android:textColor="@color/auto_color_FACC15"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/auto_str_vip"
                                android:textColor="@color/auto_color_94A3B8"
                                android:textSize="12sp" />
                        </LinearLayout>
                        
                        <View android:layout_width="12dp" android:layout_height="match_parent" />

                        <!-- Couple -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/bg_seat_config_item"
                            android:padding="12dp"
                            android:gravity="center">
                            
                            <TextView
                                android:id="@+id/tvConfigCoupleCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/auto_str_10"
                                android:textColor="@color/auto_color_A78BFA"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/auto_str_couple"
                                android:textColor="@color/auto_color_94A3B8"
                                android:textSize="12sp" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SEAT LAYOUT EDITOR CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/auto_color_111827"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="@string/auto_str_seat_layout_editor"
                            android:textColor="@color/auto_color_94A3B8"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1" />
                            
                        <LinearLayout
                            android:id="@+id/btnToggleMultiSelect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:background="@drawable/bg_btn_status_unselected"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/tvMultiSelectLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/auto_str_ch_n_nhi_u"
                                android:textColor="@color/auto_color_94A3B8"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </RelativeLayout>



                    <!-- SCREEN -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center"
                        android:text="@string/auto_str_screen"
                        android:textColor="@color/auto_color_60A5FA"
                        android:textSize="10sp"
                        android:letterSpacing="0.2"
                        android:background="@drawable/bg_screen_glow" />

                    <!-- Seat Matrix Loading -->
                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="32dp"
                        android:layout_marginBottom="32dp"
                        android:indeterminateTint="@color/auto_color_10B981" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fillViewport="true"
                        android:scrollbars="none">
                        
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:orientation="vertical">
                            
                            <LinearLayout
                                android:id="@+id/llSeats"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- BULK ACTION CONTAINER -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvBulkActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/auto_color_111827"
                        app:cardCornerRadius="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:id="@+id/tvSelectedCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:text="@string/auto_str_ch_n_0_gh"
                                    android:textColor="@color/auto_color_FFFFFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/btnDeselectAll"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:text="@string/auto_str_b_ch_n"
                                    android:textColor="@color/auto_color_94A3B8"
                                    android:textSize="12sp"
                                    android:padding="4dp" />
                            </RelativeLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="10dp">

                                <Button
                                    android:id="@+id/btnBulkActive"
                                    android:layout_width="0dp"
                                    android:layout_height="40dp"
                                    android:layout_weight="1"
                                    android:text="@string/auto_str_ho_t_ng"
                                    android:textColor="@color/auto_color_FFFFFF"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:backgroundTint="@color/auto_color_10B981"
                                    android:padding="0dp"/>

                                <View android:layout_width="8dp" android:layout_height="match_parent" />

                                <Button
                                    android:id="@+id/btnBulkMaintenance"
                                    android:layout_width="0dp"
                                    android:layout_height="40dp"
                                    android:layout_weight="1"
                                    android:text="@string/auto_str_b_o_tr"
                                    android:textColor="@color/auto_color_FFFFFF"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:backgroundTint="#F59E0B"
                                    android:padding="0dp"/>
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SEAT PRICING CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/auto_color_111827"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="@string/auto_str_seat_pricing"
                            android:textColor="@color/auto_color_94A3B8"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1" />
                            
                        <LinearLayout
                            android:id="@+id/btnEditPricing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:background="@drawable/bg_btn_status_unselected"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <!-- TODO: Tạm mock chức năng Edit -->
                            <ImageView
                                android:id="@+id/ivEditAction"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@android:drawable/ic_menu_edit"
                                app:tint="@color/auto_color_A78BFA"/>
                            <TextView
                                android:id="@+id/tvEditAction"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="@string/auto_str_edit"
                                android:textColor="@color/auto_color_A78BFA"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </RelativeLayout>
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp">
                        
                        <!-- Standard Price -->
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:text="@string/auto_str_standard_1" android:textColor="@color/auto_color_FFFFFF" android:textSize="14sp"/>
                            <TextView android:id="@+id/tvStdPrice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:text="@string/auto_str_100_000" android:textColor="@color/auto_color_60A5FA" android:textSize="14sp" android:textStyle="bold"/>
                            <LinearLayout android:id="@+id/llStdEdit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:orientation="horizontal" android:visibility="gone" android:background="@drawable/bg_seat_config_item" android:paddingHorizontal="12dp" android:paddingVertical="4dp">
                                <EditText android:id="@+id/etStdPrice" android:layout_width="80dp" android:layout_height="wrap_content" android:inputType="numberDecimal" android:textColor="@color/auto_color_60A5FA" android:textSize="14sp" android:textStyle="bold" android:gravity="end" android:background="@null" android:padding="0dp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_str_str_auto" android:textColor="@color/auto_color_60A5FA" android:textSize="14sp" android:textStyle="bold" android:layout_marginStart="2dp"/>
                            </LinearLayout>
                        </RelativeLayout>
                        
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/auto_color_1AFFFFFF"/>
                        
                        <!-- VIP Price -->
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:text="@string/auto_str_vip_1" android:textColor="@color/auto_color_FFFFFF" android:textSize="14sp"/>
                            <TextView android:id="@+id/tvVipPrice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:text="@string/auto_str_150_000" android:textColor="@color/auto_color_FACC15" android:textSize="14sp" android:textStyle="bold"/>
                            <LinearLayout android:id="@+id/llVipEdit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:orientation="horizontal" android:visibility="gone" android:background="@drawable/bg_seat_config_item" android:paddingHorizontal="12dp" android:paddingVertical="4dp">
                                <EditText android:id="@+id/etVipPrice" android:layout_width="80dp" android:layout_height="wrap_content" android:inputType="numberDecimal" android:textColor="@color/auto_color_FACC15" android:textSize="14sp" android:textStyle="bold" android:gravity="end" android:background="@null" android:padding="0dp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_str_str_auto_1" android:textColor="@color/auto_color_FACC15" android:textSize="14sp" android:textStyle="bold" android:layout_marginStart="2dp"/>
                            </LinearLayout>
                        </RelativeLayout>
                        
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/auto_color_1AFFFFFF"/>
                        
                        <!-- Couple Price -->
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:text="@string/auto_str_couple_pair" android:textColor="@color/auto_color_FFFFFF" android:textSize="14sp"/>
                            <TextView android:id="@+id/tvCouplePrice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:text="@string/auto_str_280_000" android:textColor="@color/auto_color_A78BFA" android:textSize="14sp" android:textStyle="bold"/>
                            <LinearLayout android:id="@+id/llCoupleEdit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:orientation="horizontal" android:visibility="gone" android:background="@drawable/bg_seat_config_item" android:paddingHorizontal="12dp" android:paddingVertical="4dp">
                                <EditText android:id="@+id/etCouplePrice" android:layout_width="80dp" android:layout_height="wrap_content" android:inputType="numberDecimal" android:textColor="@color/auto_color_A78BFA" android:textSize="14sp" android:textStyle="bold" android:gravity="end" android:background="@null" android:padding="0dp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_str_str_auto_2" android:textColor="@color/auto_color_A78BFA" android:textSize="14sp" android:textStyle="bold" android:layout_marginStart="2dp"/>
                            </LinearLayout>
                        </RelativeLayout>
                        
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/auto_color_1AFFFFFF"/>
                        
                        <!-- Est Capacity -->
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_str_est_full_capacity" android:textColor="@color/auto_color_94A3B8" android:textSize="14sp"/>
                            <TextView android:id="@+id/tvFullCap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="@string/auto_str_16_400_000" android:textColor="@color/auto_color_C084FC" android:textSize="14sp" android:textStyle="bold"/>
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SAVE BUTTON -->
            <Button
                android:id="@+id/btnSaveAll"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:text="@string/auto_str_save_all_changes"
                android:textColor="@color/auto_color_FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="@color/auto_color_10B981" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
