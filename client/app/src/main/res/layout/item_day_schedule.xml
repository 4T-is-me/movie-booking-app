<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <!-- Cột Thứ & Ngày bên trái -->
    <LinearLayout
        android:layout_width="45dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDayOfWeek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/auto_color_FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Mon" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="14 Jul" />
    </LinearLayout>

    <!-- Đường vạch chia dọc -->
    <View
        android:layout_width="1.5dp"
        android:layout_height="55dp"
        android:layout_marginHorizontal="5dp"
        android:background="@color/divider_yellow_alpha" />

    <!-- Card chứa thông tin Ca làm việc -->
    <LinearLayout
        android:id="@+id/layoutShiftContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_shift_item"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Nền Icon bo góc -->
        <FrameLayout
            android:id="@+id/layoutIconBg"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_sun">

            <ImageView
                android:id="@+id/ivShiftIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_sun"
                app:tint="@color/tint_sun_yellow" />
        </FrameLayout>

        <!-- Tên ca làm việc -->
        <TextView
            android:id="@+id/tvShiftName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="@color/auto_color_FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Morning - Night" />

        <!-- Badge DAY OFF -->
        <TextView
            android:id="@+id/tvDayOffBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_day_off"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="@string/auto_str_day_off_manager"
            android:textColor="@color/tint_sun_yellow"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</LinearLayout>