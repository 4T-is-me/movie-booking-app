<?xml version="1.0" encoding="utf-8"?>
<!-- [Legacy: XML Views] - CardView đại diện cho hình dáng 1 cái ghế -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardSeat"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:layout_margin="4dp"
    android:visibility="visible"
    app:cardBackgroundColor="@color/default_background"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    tools:visibility="visible">

    <!-- [Legacy: XML Views] - TEXTVIEW: Hiển thị mã số ghế (Ví dụ: A1) -->
    <TextView
        android:id="@+id/tvSeatLabel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="A1"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="visible" />

</com.google.android.material.card.MaterialCardView>