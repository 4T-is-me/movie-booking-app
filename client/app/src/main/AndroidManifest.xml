<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required on Android 13+ (API 33) to show push notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Moviebookingapp"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".view.activity.MainActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".view.activity.ProfileActivity"
            android:exported="true"
            android:theme="@style/Theme.Moviebookingapp" />
        <activity
            android:name=".view.activity.EditProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.Moviebookingapp"
            android:windowSoftInputMode="adjustPan|stateHidden" />
        <activity
            android:name=".view.activity.manager.ManagerRoomListActivity"
            android:exported="false" />
        <activity
            android:name=".view.activity.manager.ManagerSeatActivity"
            android:exported="false"
            android:theme="@style/Theme.Moviebookingapp" />
        <activity
            android:name=".view.activity.ChangePasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.Moviebookingapp"
            android:windowSoftInputMode="adjustPan|stateHidden" />
        <activity
            android:name=".view.activity.PaymentActivity"
            android:exported="false"
            android:theme="@style/Theme.Moviebookingapp"
            android:windowSoftInputMode="adjustPan|stateHidden" />
        <activity
            android:name=".view.activity.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.Moviebookingapp" />
        <activity
            android:name=".view.activity.RegisterActivity"
            android:exported="true"
            android:theme="@style/Theme.Moviebookingapp" /> <!-- Keeping your enhanced seating map activity -->
        <activity
            android:name=".view.activity.SelectSeatActivity"
            android:exported="true"
            android:theme="@style/Theme.Moviebookingapp" />
        <activity
            android:name=".view.activity.MovieDetailActivity"
            android:exported="true"
            android:theme="@style/Theme.Moviebookingapp" />
        <activity
            android:name=".view.activity.PromotionDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Moviebookingapp" />
        <activity
            android:name=".view.activity.AdminActivity"
            android:exported="true"
            android:theme="@style/Theme.Moviebookingapp" />
        <activity
            android:name=".view.activity.AdminStaffActivity"
            android:exported="false"
            android:theme="@style/Theme.Moviebookingapp"
            android:windowSoftInputMode="adjustPan|stateHidden" />

        <activity
            android:name=".view.activity.AdminPromotionActivity"
            android:exported="false"
            android:theme="@style/Theme.Moviebookingapp"
            android:windowSoftInputMode="adjustPan|stateHidden" />

        <activity
            android:name=".view.activity.AdminEditPromotionActivity"
            android:exported="false"
            android:theme="@style/Theme.Moviebookingapp"
            android:windowSoftInputMode="adjustPan|stateHidden" />
        <activity
            android:name=".view.activity.PurchaseHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.Moviebookingapp" />
        <activity
            android:name=".view.activity.BookingDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Moviebookingapp" />
        <activity
            android:name=".view.activity.ScoreHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".view.activity.RewardPointsActivity"
            android:exported="false" />
        <activity
            android:name=".view.activity.ForgotPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.Moviebookingapp" />
        <activity
            android:name=".view.activity.VerifyOtpActivity"
            android:exported="false"
            android:theme="@style/Theme.Moviebookingapp" />
        <activity
            android:name=".view.activity.ResetPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.Moviebookingapp" />
        <activity
            android:name=".view.activity.ManagerActivity"
            android:exported="false"
            android:theme="@style/Theme.Moviebookingapp" />
        <activity
            android:name=".view.activity.manager.ManagerReportActivity"
            android:exported="false"
            android:theme="@style/Theme.Moviebookingapp" />

        <activity
            android:name=".view.activity.manager.ManagerStaffActivity"
            android:exported="false"
            android:theme="@style/Theme.Moviebookingapp" />

     
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification_small" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="movie_booking_channel" />
        <service
            android:name=".data.local.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter android:priority="-500">
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name=".view.activity.NotificationActivity"
            android:exported="false"
            android:theme="@style/Theme.Moviebookingapp" />

        <activity
            android:name=".view.activity.VideoListActivity"
            android:exported="false"
            android:theme="@style/Theme.Moviebookingapp" />

    </application>

</manifest>