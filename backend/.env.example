# CONFIG SERVER PORT
PORT=5000

# CONFIG DATABASE (MONGODB)
# Thay thế các thông tin dưới đây bằng tài khoản MongoDB local hoặc Atlas của bạn

MONGO_URI=mongodb://localhost:27017/movie_booking_db

# SECURITY & AUTHENTICATION (JWT)
# Điền một chuỗi ký tự ngẫu nhiên bất kỳ để làm khóa bảo mật mã hóa Token

JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d